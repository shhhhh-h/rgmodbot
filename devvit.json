{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "rgmodbot",
  "version": "0.0.1",
  "description": "A simple automoderator supplement bot for r/royalsgossip",
  "type": "app",
  "server": { "entry": "src/main.ts" },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_POST", "SUBMIT_COMMENT"]
    },
    "redis": true,
    "media": false,
    "realtime": false
  },
  "settings": {
    "global": {
      "apiKey": {
        "type": "string",
        "label": "API Key",
        "isSecret": true,
        "defaultValue": ""
      }
    },
    "subreddit": {
      "welcomeMessage": {
        "type": "string",
        "label": "Welcome Message",
        "defaultValue": "Welcome!"
      }
    }
  },
  "dev": { "subreddit": "rgmodbot_dev" }
}
